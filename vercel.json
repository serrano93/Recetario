{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "comment": "Todo a la SPA menos /api, que son funciones serverless.",
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
